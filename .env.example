# ── Universal Workspace MCP — environment configuration ──────────────
# Copy to .env and edit: cp .env.example .env

# Bind address. Keep 127.0.0.1 — the Cloudflare tunnel is the only way in.
HOST=127.0.0.1
PORT=3333

# Data directory (database + workspaces). Absolute path or relative to project root.
DATA_DIR=./data

# REQUIRED. Secret used to hash API tokens at rest.
# Generate: openssl rand -base64 48
# If you lose this, all existing tokens become invalid.
TOKEN_PEPPER=change-me-to-a-long-random-string

# Logging: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Execution engine ─────────────────────────────────────────
# disabled | restricted | allowlist
EXEC_MODE=restricted
EXEC_DEFAULT_TIMEOUT_MS=120000
EXEC_MAX_TIMEOUT_MS=600000
EXEC_MAX_OUTPUT_BYTES=1048576
EXEC_MAX_CONCURRENT_PER_WORKSPACE=5
# Only used when EXEC_MODE=allowlist (comma-separated command prefixes)
ALLOWED_COMMANDS=git,npm,npx,node,ls,cat,pwd,echo,mkdir,cp,mv,find,grep,sed,awk,head,tail,wc,tar,tsc,vitest

# ── Limits ───────────────────────────────────────────────────
MAX_FILE_BYTES=5242880
MAX_BODY_BYTES=4194304
RATE_LIMIT_PER_MIN=120
EVENT_RETENTION_DAYS=90

# Default for git init on new workspaces
GIT_ENABLED_DEFAULT=true
